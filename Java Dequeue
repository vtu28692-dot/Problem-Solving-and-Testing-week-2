import java.util.*;

public class Solution {
    public static void main(String[] args) {
        Scanner in = new Scanner(System.in);
        Deque<Integer> deque = new ArrayDeque<>();
        Set<Integer> set = new HashSet<>();

        int n = in.nextInt();
        int m = in.nextInt();
        int maxUnique = 0;

        for (int i = 0; i < n; i++) {
            int num = in.nextInt();

            deque.addLast(num);
            set.add(num);

            if (deque.size() == m) {
                if (set.size() > maxUnique) {
                    maxUnique = set.size();
                }

                // If max possible unique elements reached, break early to optimize runtime
                if (maxUnique == m) {
                    System.out.println(maxUnique);
                    return;
                }

                // Remove the oldest element as the sliding window moves forward
                int removed = deque.removeFirst();
                if (!deque.contains(removed)) {
                    set.remove(removed);
                }
            }
        }

        System.out.println(maxUnique);
    }
}
